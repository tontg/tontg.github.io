# Generated by tools/audit.mjs. Apache mod_headers and AllowOverride FileInfo required.
Options -Indexes
AddType text/javascript .mjs
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(self), microphone=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-v3hAeHXpUYRHXnJ1di5J06tueCbK2N7J7Qr9xWn60po=' 'sha256-BFy38ze2n3zCvXUHek+Ejz/BM2vIZG5/Iatrnzpzp8k=' 'sha256-gfXH9mhYD4rNHSfBgopzl3RvhZGwlAIJQPd9qQM897E=' 'sha256-CpGfeJL4j6CpN7Qph/igSlOjveWjtp3CKya8hw8UNGQ='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  <Files "qr-worker.js">
    Header always set Content-Security-Policy "default-src 'none'; script-src 'self' blob: 'unsafe-eval'; connect-src 'self'"
  </Files>
  <Files "service-worker.js">
    Header always set Cache-Control "no-cache"
  </Files>
</IfModule>
